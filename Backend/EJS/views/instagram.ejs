<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
    <style>
        img {
            height: 100px;
            width: 100px;
        }
    </style>
</head>
<body>
    <!-- <h2>This page belongs to @<=username%> </h2> -->
    <h2>This page belongs to <%= data.name %> </h2>
    <button>Follow</button>
    <button>Message</button>

    <p>Followers : <%= data.followers %> &nbsp; &nbsp; Following : <%= data.following %> </p>
    <hr>

    <!-- <h3>Accounts that follows you:-</h3> -->
    <!-- <ul>
        < for(let name of followers) { %>
            <li> <= name %> </li>  //comment karne ke liye % hataye hai
        < } %>
    </ul> -->

    
    <% for(post of data.posts) { %>
        <img src="<%=post.image%>" alt="some image">
        <p>
            likes: <%=post.likes %> &nbsp; &nbsp; comments: <%= post.comments %>
        </p>
    <% } %>

</body>
</html>
